{
  "manifest_version": 3,
  "name": "Pointmark",
  "version": "0.1.0",
  "description": "Point, annotate, copy element context for any AI agent.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Pointmark — picker: Alt+A"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Toggle element picker"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
